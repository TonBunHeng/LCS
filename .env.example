# ==============================================================================
# LocalDevServer Environment Configuration
# ==============================================================================

# Project & Domain Settings
COMPOSE_PROJECT_NAME=localdev
DOMAIN_SUFFIX=local
DEFAULT_PHP_VERSION=8.5
DEFAULT_PHP_SERVICE=php:9000

# Host System User & Group ID (Run 'id -u' and 'id -g' on macOS)
PUID=501
PGID=20

# Port Mapping (Configured to avoid macOS conflicts)
APACHE_PORT=80
NGINX_PORT=8080
PHPMYADMIN_PORT=8081

MYSQL_PORT=3307
MARIADB_PORT=3308
POSTGRES_PORT=5433
REDIS_PORT=6379

# Database Credentials - MySQL 8.x
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=localdev_mysql
MYSQL_USER=devuser
MYSQL_PASSWORD=devpass

# Database Credentials - MariaDB
MARIADB_ROOT_PASSWORD=rootpass
MARIADB_DATABASE=localdev_mariadb
MARIADB_USER=devuser
MARIADB_PASSWORD=devpass

# Database Credentials - PostgreSQL 16+
POSTGRES_DB=localdev_postgres
POSTGRES_USER=devuser
POSTGRES_PASSWORD=devpass

# Node.js Version
NODE_VERSION=20

