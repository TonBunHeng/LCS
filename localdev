#!/bin/bash
# ==============================================================================
# LocalDevServer CLI Management Tool
# ==============================================================================
set -e

BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$BASE_DIR"

# Colors for terminal output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# Ensure .env exists
if [ ! -f "$BASE_DIR/.env" ]; then
    if [ -f "$BASE_DIR/.env.example" ]; then
        echo -e "${YELLOW}Warning: .env not found. Creating from .env.example...${NC}"
        cp "$BASE_DIR/.env.example" "$BASE_DIR/.env"
    else
        echo -e "${RED}Error: Neither .env nor .env.example found!${NC}"
        exit 1
    fi
fi

# Export environment variables from .env
set -a
source "$BASE_DIR/.env"
set +a

DOMAIN_SUFFIX="${DOMAIN_SUFFIX:-local}"
DEFAULT_PHP_VERSION="${DEFAULT_PHP_VERSION:-8.3}"
HTDOCS_DIR="$BASE_DIR/htdocs"

# Helper: Print styled header
print_header() {
    echo -e "${BLUE}${BOLD}======================================================${NC}"
    echo -e "${CYAN}${BOLD}   LocalDevServer - Local Web Development on macOS   ${NC}"
    echo -e "${BLUE}${BOLD}======================================================${NC}"
}

# Helper: Get PHP container for project
get_php_container() {
    echo "localdev_php"
}

# ------------------------------------------------------------------------------
# Commands
# ------------------------------------------------------------------------------

cmd_start() {
    print_header
    local service="$1"
    if [ -n "$service" ]; then
        echo -e "${GREEN}Starting service: ${service}...${NC}"
        docker compose up -d "$service"
    else
        echo -e "${GREEN}Starting all LocalDevServer services...${NC}"
        docker compose up -d
        echo -e "${GREEN}Services started successfully!${NC}"
        echo -e "Dashboard: ${BOLD}http://localhost:${APACHE_PORT:-80}${NC}"
        echo -e "phpMyAdmin: ${BOLD}http://localhost:${PHPMYADMIN_PORT:-8081}${NC}"
    fi
    cmd_vhost_sync
}

cmd_stop() {
    local service="$1"
    if [ -n "$service" ]; then
        echo -e "${YELLOW}Stopping service: ${service}...${NC}"
        docker compose stop "$service"
    else
        echo -e "${YELLOW}Stopping all LocalDevServer services...${NC}"
        docker compose stop
        echo -e "${GREEN}All services stopped.${NC}"
    fi
}

cmd_restart() {
    local service="$1"
    if [ -n "$service" ]; then
        echo -e "${YELLOW}Restarting service: ${service}...${NC}"
        docker compose restart "$service"
    else
        echo -e "${YELLOW}Restarting all LocalDevServer services...${NC}"
        docker compose restart
        cmd_vhost_sync
    fi
}

cmd_status() {
    print_header
    echo -e "${BOLD}Docker Services Status:${NC}"
    docker compose ps
}

cmd_logs() {
    local service="$1"
    shift || true
    if [ -n "$service" ]; then
        docker compose logs -f "$service" "$@"
    else
        docker compose logs -f "$@"
    fi
}

cmd_build() {
    local service="$1"
    if [ -n "$service" ]; then
        echo -e "${GREEN}Building image for ${service}...${NC}"
        docker compose build "$service"
    else
        echo -e "${GREEN}Building all custom images...${NC}"
        docker compose build
    fi
}

cmd_update() {
    print_header
    echo -e "${GREEN}Pulling latest base images...${NC}"
    docker compose pull
    echo -e "${GREEN}Rebuilding custom containers...${NC}"
    docker compose build
    echo -e "${GREEN}Update complete.${NC}"
}

cmd_doctor() {
    print_header
    echo -e "${BOLD}Running System Diagnostics & Environment Health Check:${NC}\n"

    # 1. Docker check
    echo -n "1. Docker Engine: "
    if docker info >/dev/null 2>&1; then
        echo -e "${GREEN}[OK] Running${NC}"
    else
        echo -e "${RED}[FAIL] Docker daemon is not running! Please start Docker Desktop.${NC}"
    fi

    # 2. Docker Compose check
    echo -n "2. Docker Compose: "
    if docker compose version >/dev/null 2>&1; then
        echo -e "${GREEN}[OK] Available ($(docker compose version --short))${NC}"
    else
        echo -e "${RED}[FAIL] Docker Compose not found.${NC}"
    fi

    # 3. Environment file check
    echo -n "3. Configuration (.env): "
    if [ -f "$BASE_DIR/.env" ]; then
        echo -e "${GREEN}[OK] Present${NC}"
    else
        echo -e "${RED}[FAIL] .env file is missing.${NC}"
    fi

    # 4. Port conflict checks
    echo -e "\n4. Checking Port Availability on Host:"
    ports_to_check=(
        "Apache:${APACHE_PORT:-80}"
        "MySQL:${MYSQL_PORT:-3307}"
        "MariaDB:${MARIADB_PORT:-3308}"
        "PostgreSQL:${POSTGRES_PORT:-5433}"
        "phpMyAdmin:${PHPMYADMIN_PORT:-8081}"
        "Redis:${REDIS_PORT:-6379}"
    )

    for entry in "${ports_to_check[@]}"; do
        name="${entry%%:*}"
        port="${entry##*:}"
        echo -n "   - $name (Port $port): "
        # Check if listening outside docker
        if lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
            p_process=$(lsof -nP -iTCP:"$port" -sTCP:LISTEN | tail -n 1 | awk '{print $1}')
            if [[ "$p_process" =~ com.docke|docker ]]; then
                echo -e "${GREEN}[OK] In use by LocalDevServer (Docker)${NC}"
            else
                echo -e "${YELLOW}[WARNING] In use by host process: $p_process${NC}"
            fi
        else
            echo -e "${GREEN}[OK] Port is free${NC}"
        fi
    done

    # 5. Hosts file check
    echo -e "\n5. macOS Local Domains (/etc/hosts):"
    if grep -q "### LocalDevServer BEGIN ###" /etc/hosts 2>/dev/null; then
        entry_count=$(sed -n '/### LocalDevServer BEGIN ###/,/### LocalDevServer END ###/p' /etc/hosts | grep -v '###' | grep -c '127.0.0.1' || true)
        echo -e "   ${GREEN}[OK] Configured with ${entry_count} local domain entry(ies)${NC}"
    else
        echo -e "   ${YELLOW}[INFO] LocalDevServer block not yet added to /etc/hosts.${NC}"
        echo -e "   Run '${BOLD}./localdev hosts:sync${NC}' to synchronize all domains."
    fi

    echo -e "\n${GREEN}${BOLD}Diagnostics completed.${NC}\n"
}

cmd_vhost_sync() {
    if docker ps --format '{{.Names}}' | grep -q "localdev_apache"; then
        echo -e "${CYAN}Syncing Apache VirtualHosts...${NC}"
        docker exec localdev_apache /scripts/generate-vhosts.sh
        docker exec localdev_apache httpd -k graceful 2>/dev/null || true
        echo -e "${GREEN}Apache VirtualHosts synced and reloaded.${NC}"
    fi
}

cmd_hosts_sync() {
    print_header
    echo -e "${CYAN}Synchronizing local domains with /etc/hosts...${NC}"

    local domains=("localhost")
    if [ -d "$HTDOCS_DIR" ]; then
        for p in "$HTDOCS_DIR"/*; do
            if [ -d "$p" ]; then
                local bname=$(basename "$p")
                if [[ ! "$bname" =~ ^\. ]]; then
                    domains+=("${bname}.${DOMAIN_SUFFIX}")
                fi
            fi
        done
    fi

    echo -e "Detected ${#domains[@]} domain(s):"
    for d in "${domains[@]}"; do
        echo -e "  - ${BOLD}http://$d${NC}"
    done

    # Generate hosts block
    local tmp_file=$(mktemp)
    echo "### LocalDevServer BEGIN ###" > "$tmp_file"
    for d in "${domains[@]}"; do
        if [ "$d" != "localhost" ]; then
            echo "127.0.0.1 $d www.$d" >> "$tmp_file"
        fi
    done
    echo "### LocalDevServer END ###" >> "$tmp_file"

    # Check if sudo is needed
    echo -e "\n${YELLOW}Updating /etc/hosts (requires macOS administrator/sudo permissions)...${NC}"
    
    # Remove existing block if present, then append new block
    if sudo /bin/sh -c "
        if grep -q '### LocalDevServer BEGIN ###' /etc/hosts; then
            sed -i '' '/### LocalDevServer BEGIN ###/,/### LocalDevServer END ###/d' /etc/hosts
        fi
        cat '$tmp_file' >> /etc/hosts
    "; then
        rm -f "$tmp_file"
        echo -e "${GREEN}Successfully updated /etc/hosts!${NC}"
        # Flush macOS DNS cache
        echo -e "${CYAN}Flushing macOS DNS cache...${NC}"
        sudo dscacheutil -flushcache 2>/dev/null || true
        sudo killall -HUP mDNSResponder 2>/dev/null || true
        echo -e "${GREEN}DNS cache flushed.${NC}"
    else
        rm -f "$tmp_file"
        echo -e "${RED}Failed to update /etc/hosts.${NC}"
        exit 1
    fi
}

cmd_create() {
    local type="$1"
    local name="$2"
    local version="$3"

    if [ -z "$type" ] || [ -z "$name" ]; then
        echo -e "${RED}Usage: ./localdev create <php|laravel> <project-name> [php-version]${NC}"
        exit 1
    fi

    # Sanitize project name
    if [[ ! "$name" =~ ^[a-zA-Z0-9_-]+$ ]]; then
        echo -e "${RED}Error: Project name can only contain letters, numbers, dashes, and underscores.${NC}"
        exit 1
    fi

    local project_path="$HTDOCS_DIR/$name"
    if [ -d "$project_path" ]; then
        echo -e "${RED}Error: Directory 'htdocs/$name' already exists!${NC}"
        exit 1
    fi

    print_header
    echo -e "${GREEN}Creating new ${type} project: ${BOLD}${name}${NC}..."

    mkdir -p "$project_path"

    # Set PHP version if specified
    if [ -n "$version" ]; then
        echo "$version" > "$project_path/.php-version"
