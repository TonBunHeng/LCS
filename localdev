cmd_list() {
    print_header
    echo -e "${BOLD}Detected Projects in htdocs/:${NC}\n"

    printf "%-22s %-26s %-16s %-10s %-12s\n" "PROJECT" "LOCAL DOMAIN" "TYPE" "PHP" "DOCUMENT ROOT"
    echo "----------------------------------------------------------------------------------------"

    if [ -d "$HTDOCS_DIR" ]; then
        local count=0
        for p in "$HTDOCS_DIR"/*; do
            if [ -d "$p" ]; then
                local bname=$(basename "$p")
                if [[ ! "$bname" =~ ^\. ]]; then
                    count=$((count+1))
                    local is_laravel="No"
                    local type_label="Standard PHP"
                    local docroot="./"
                    if [ -d "$p/public" ] || [ -f "$p/artisan" ]; then
                        type_label="Laravel"
                        docroot="public/"
                    fi

                    local php_ver="8.5 (Latest)"
                    local domain="${bname}.${DOMAIN_SUFFIX}"
                    printf "%-22s %-26s %-16s %-10s %-12s\n" "$bname" "http://$domain" "$type_label" "PHP $php_ver" "$docroot"
                fi
            fi
        done
        if [ $count -eq 0 ]; then
            echo "No projects found in htdocs/. Create one using './localdev create php <name>'"
        fi
    fi
    echo ""
}

cmd_remove() {
    local name="$1"
    if [ -z "$name" ]; then
        echo -e "${RED}Usage: ./localdev remove <project-name>${NC}"
        exit 1
    fi

    local project_path="$HTDOCS_DIR/$name"
    if [ ! -d "$project_path" ]; then
        echo -e "${RED}Error: Project '$name' does not exist in htdocs/${NC}"
        exit 1
    fi

    echo -e "${RED}${BOLD}WARNING: This will permanently delete 'htdocs/$name' and its contents!${NC}"
    read -p "Are you sure you want to proceed? [y/N]: " confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        rm -rf "$project_path"
        echo -e "${GREEN}Project '$name' removed.${NC}"
        cmd_vhost_sync
        echo -e "${YELLOW}Syncing hosts file to remove domain...${NC}"
        cmd_hosts_sync
    else
        echo -e "${YELLOW}Aborted.${NC}"
    fi
}

cmd_switch_php() {
    echo -e "${CYAN}LocalDevServer uses the unified PHP 8.5+ (Latest) environment for all projects.${NC}"
}

cmd_artisan() {
    local project="$1"
    shift || true

    if [ -z "$project" ]; then
        echo -e "${RED}Usage: ./localdev artisan <project-name> <artisan-command>${NC}"
        exit 1
    fi

    local container=$(get_php_container "$project")
    echo -e "${CYAN}Running php artisan in container '${container}' for '${project}'...${NC}"
    docker exec -it -w "/var/www/html/$project" "$container" php artisan "$@"
}

cmd_composer() {
    local project="$1"
    shift || true

    if [ -z "$project" ]; then
        echo -e "${RED}Usage: ./localdev composer <project-name> <composer-command>${NC}"
        exit 1
    fi

    local container=$(get_php_container "$project")
    echo -e "${CYAN}Running composer in container '${container}' for '${project}'...${NC}"
    docker exec -it -w "/var/www/html/$project" "$container" composer "$@"
}

cmd_npm() {
