        exit 1
    fi

    echo -e "${CYAN}Running npm in node container for '${project}'...${NC}"
    docker exec -it -w "/var/www/html/$project" localdev_node npm "$@"
}

cmd_shell() {
    local service="${1:-php83}"
    local container="localdev_${service}"
    if ! docker ps --format '{{.Names}}' | grep -q "^${container}$"; then
        container="$service"
    fi
    echo -e "${CYAN}Opening interactive shell in ${container}...${NC}"
    docker exec -it "$container" /bin/sh 2>/dev/null || docker exec -it "$container" /bin/bash
}

cmd_backup() {
    bash "$BASE_DIR/scripts/backup.sh" "$@"
}

cmd_restore() {
    bash "$BASE_DIR/scripts/restore.sh" "$@"
}

cmd_help() {
    print_header
    echo -e "${BOLD}Available Commands:${NC}"
    echo -e "  ${GREEN}./localdev start [service]${NC}          Start all or a specific service"
    echo -e "  ${GREEN}./localdev stop [service]${NC}           Stop all or a specific service"
    echo -e "  ${GREEN}./localdev restart [service]${NC}        Restart all or a specific service"
    echo -e "  ${GREEN}./localdev status${NC}                   Show service status and ports"
    echo -e "  ${GREEN}./localdev logs [service]${NC}           View container logs in real time"
    echo -e "  ${GREEN}./localdev build [service]${NC}          Rebuild docker container images"
    echo -e "  ${GREEN}./localdev update${NC}                   Pull latest images and rebuild"
    echo -e "  ${GREEN}./localdev doctor${NC}                   Run environment diagnostics & port audit"
    echo ""
    echo -e "  ${GREEN}./localdev create php <name> [ver]${NC}  Create new standard PHP project (8.2/8.3/8.4)"
    echo -e "  ${GREEN}./localdev create laravel <name> [ver]${NC} Create new Laravel project"
    echo -e "  ${GREEN}./localdev list${NC}                     List all projects in htdocs/"
    echo -e "  ${GREEN}./localdev remove <name>${NC}            Safely remove a project and its domain"
    echo -e "  ${GREEN}./localdev php:switch <prj> <ver>${NC}  Switch a project's PHP version"
    echo ""
    echo -e "  ${GREEN}./localdev hosts:sync${NC}               Sync all project domains with /etc/hosts"
    echo -e "  ${GREEN}./localdev vhost:sync${NC}               Regenerate and reload Apache VirtualHosts"
    echo ""
    echo -e "  ${GREEN}./localdev artisan <prj> <cmd>${NC}     Execute artisan commands inside container"
    echo -e "  ${GREEN}./localdev composer <prj> <cmd>${NC}    Execute composer commands inside container"
    echo -e "  ${GREEN}./localdev npm <prj> <cmd>${NC}         Execute npm commands inside node container"
    echo -e "  ${GREEN}./localdev shell [service]${NC}         Open interactive shell in container"
    echo ""
    echo -e "  ${GREEN}./localdev backup [mysql|mariadb|postgres|all]${NC} Backup databases to backups/"
    echo -e "  ${GREEN}./localdev restore <file> [type]${NC}  Restore a database dump"
    echo ""
}

# ------------------------------------------------------------------------------
# Dispatcher
# ------------------------------------------------------------------------------
action="$1"
shift || true

case "$action" in
    start)
        cmd_start "$@"
        ;;
    stop)
        cmd_stop "$@"
        ;;
    restart)
        cmd_restart "$@"
        ;;
    status)
        cmd_status
        ;;
    logs)
        cmd_logs "$@"
        ;;
    build)
        cmd_build "$@"
        ;;
    update)
        cmd_update
        ;;
    doctor)
        cmd_doctor
        ;;
    create)
        cmd_create "$@"
        ;;
    list)
        cmd_list
        ;;
    remove)
        cmd_remove "$@"
        ;;
    php:switch)
        cmd_switch_php "$@"
        ;;
    hosts:sync|sync-hosts)
        cmd_hosts_sync
        ;;
    vhost:sync|sync-vhosts)
        cmd_vhost_sync
        ;;
    artisan)
        cmd_artisan "$@"
        ;;
    composer)
        cmd_composer "$@"
        ;;
    npm)
        cmd_npm "$@"
        ;;
    shell)
        cmd_shell "$@"
        ;;
    backup)
        cmd_backup "$@"
        ;;
    restore)
        cmd_restore "$@"
        ;;
    help|--help|-h|"")
        cmd_help
        ;;
    *)
        echo -e "${RED}Unknown command: $action${NC}"
        cmd_help
        exit 1
        ;;
esac

